GITHUB_TOKEN=
NOTION_TOKEN=
NOTION_REPOSITORY_DATABASE_ID=
NOTION_ISSUE_DATABASE_ID=
NOTION_PULL_REQUEST_DATABASE_ID=
# Ofelia のスケジュール用タイムゾーン。同期アプリは未使用。
TIMEZONE=Asia/Tokyo
# Ofelia の cron（空なら @hourly）。秒から始める 6 フィールド（例: 毎時0分は 0 0 * * * *）。
# 5 フィールドだけ書くとエラーにならず左に 1 つずつずれて解釈される（秒=0、曜日=*）。
# 例: 0 * * * * は毎分、0 3 * * * は毎時3分（日次3:00のつもりだと意図とずれる）。同期アプリには未使用。
OFELIA_SCHEDULE=
